{
  "name": "yamldocdock",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/cli.js",
  "bin": {
    "yamldocdock": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/cli.ts",
    "test": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\""
  },
  "keywords": [
    "yaml",
    "documentation",
    "generator",
    "aws",
    "cloudformation",
    "cfn"
  ],
  "author": "Wavecre8 <wavecre8dev@gmail.com> (https://github.com/wavecre8)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavecre8/YamlDocDock.git"
  },
  "bugs": {
    "url": "https://github.com/wavecre8/YamlDocDock/issues"
  },
  "homepage": "https://github.com/wavecre8/YamlDocDock#readme",
  "description": "Generate human-readable documentation from YAML files",
  "dependencies": {
    "browser-sync": "^3.0.4",
    "chokidar": "^5.0.0",
    "commander": "^14.0.2",
    "ejs": "^3.1.10",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.21",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/ejs": "^3.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  }
}
