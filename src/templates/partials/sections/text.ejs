<%
    // Treat the scalar value as the "content"
    const logicalId = sectionName;
    const isMainDescription = (sectionName === 'Description');
    
    let descriptionItems = [];
    if (isMainDescription) {
        if (Array.isArray(sectionData)) {
            descriptionItems = sectionData;
        } else if (typeof sectionData === 'object' && sectionData !== null) {
            descriptionItems = Object.values(sectionData);
        }
    }
    
    // Check if it's an array of {fileName, content} objects
    const isDescriptionArray = isMainDescription && descriptionItems.length > 0 && typeof descriptionItems[0] === 'object' && descriptionItems[0] !== null && 'fileName' in descriptionItems[0];
%>
<div id="section-<%= sectionIndex %>-content" class="collapsible-wrapper transition-all duration-300 ease-in-out">
   <div class="p-6 overflow-hidden min-h-0">
           <% if (isDescriptionArray) { %>
               <% descriptionItems.forEach((item, itemIndex) => { %>
                   <%
                       // Use common card component
                       const contentHtml = renderMarkdownClient(item.content);
                       const cardId = `desc-file-card-${itemIndex}`;
                       const contentId = `desc-file-${itemIndex}`;
                       const iconId = `desc-file-icon-${itemIndex}`;
                   %>
                   <%- include('/partials/components/card.ejs', {
                       cardId: cardId,
                       contentId: contentId,
                       iconId: iconId,
                       title: escapeHtml(item.fileName),
                       contentHtml: contentHtml,
                       extraHeaderHtml: '',
                       isCollapsed: false
                   }) %>
               <% }); %>
           <% } else { %>
               <div class="bg-white p-4 rounded-lg border border-slate-200 font-mono text-sm text-slate-700 whitespace-pre-wrap"><%- isMainDescription ? renderMarkdownClient(sectionData) : escapeHtml(sectionData) %></div>
           <% } %>
   </div>
</div>
