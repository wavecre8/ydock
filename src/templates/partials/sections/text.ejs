<%
    // スカラー値のコンテキスト識別子導出
    const logicalId = sectionName;

    // 構造化テキストセクション判定のStrategy委譲
    const isStructured = (typeof strategy !== 'undefined' && strategy && strategy.isStructuredTextSection)
        ? strategy.isStructuredTextSection(sectionName, sectionData)
        : (sectionName === 'Description' && Array.isArray(sectionData) && sectionData.length > 0 && typeof sectionData[0] === 'object' && sectionData[0] !== null && 'fileName' in sectionData[0]);

    // マークダウン解釈対象セクション判定のStrategy委譲
    const isMarkdown = (typeof strategy !== 'undefined' && strategy && strategy.isMarkdownTextSection)
        ? strategy.isMarkdownTextSection(sectionName)
        : (sectionName === 'Description');

    let descriptionEntries = [];
    if (isStructured) {
        if (Array.isArray(sectionData)) {
            descriptionEntries = sectionData.map((item, idx) => [String(idx), item]);
        } else if (typeof sectionData === 'object' && sectionData !== null) {
            descriptionEntries = Object.entries(sectionData);
        }
    }

    // 非構造化テキストの安全なHTML文字列導出
    let plainContentHtml = '';
    if (!isStructured) {
        if (typeof sectionData === 'string') {
            plainContentHtml = isMarkdown ? renderMarkdownClient(sectionData) : escapeHtml(sectionData);
        } else if (sectionData !== null && typeof sectionData !== 'undefined') {
            plainContentHtml = escapeHtml(JSON.stringify(sectionData, null, 2));
        }
    }
%>
<div id="section-<%= sectionIndex %>-content" class="collapsible-wrapper transition-all duration-300 ease-in-out">
   <div class="p-6 overflow-hidden min-h-0">
           <% if (isStructured) { %>
               <% descriptionEntries.forEach(([key, item], itemIndex) => { %>
                   <%
                       // 共通カードコンポーネント用の識別子生成
                       const contentHtml = renderMarkdownClient(item.content);
                       const ctx = (typeof createContext === 'function')
                           ? createContext([sectionName, String(key)])
                           : null;
                       const cardId = ctx ? ctx.path : `desc-file-card-${sectionIndex}-${itemIndex}`;
                       const contentId = `card-${sectionIndex}-${itemIndex}-content`;
                       const iconId = `${contentId}-icon`;
                   %>
                   <%- include('/partials/components/card.ejs', {
                       cardId: cardId,
                       contentId: contentId,
                       iconId: iconId,
                       title: escapeHtml(item.fileName),
                       contentHtml: contentHtml,
                       extraHeaderHtml: '',
                       isCollapsed: false
                   }) %>
               <% }); %>
           <% } else { %>
               <div class="bg-white p-4 rounded-lg border border-slate-200 font-mono text-sm text-slate-700 whitespace-pre-wrap"><%- plainContentHtml %></div>
           <% } %>
   </div>
</div>
