<% if (typeof targetObject === 'object' && targetObject !== null && !Array.isArray(targetObject)) { %>
    <% if (isIntrinsic(targetObject)) { %>
        <!-- Intrinsic Function Value (e.g. Conditions) - Render as Code Block -->
        <div class="bg-slate-50 border border-slate-200 rounded p-4 font-mono text-sm overflow-x-auto">
            <%- renderFlow(targetObject) %>
        </div>
    <% } else { %>
<% 
    // Data preparation moved to Strategy
    // Map them to local variables for loop compatibility
    const attributeEntries = components.attributes;
    const pEntries = components.properties;
    
    // リソースにおけるPropertiesブロックの保持判定をStrategyへ委譲
    const isPropertiesBlock = (typeof strategy !== 'undefined' && strategy && strategy.hasPropertiesBlock)
        ? strategy.hasPropertiesBlock(resource)
        : !!resource?.Properties;
%>

<% if (attributeEntries.length > 0) { %>
    <div class="mb-6">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Attributes</h4>
        <div class="table-container-standard">
            <table class="w-full text-left border-collapse table-fixed top-level-table text-sm">
                <colgroup>
                    <col style="width: var(--col-width-level-0);">
                    <col>
                </colgroup>
                <thead>
                    <tr class="text-xs uppercase tracking-wider text-slate-600 bg-slate-200">
                        <th class="py-3 px-4 relative">
                            Attribute
                            <div class="col-resizer" data-level="0"></div>
                        </th>
                        <th class="py-3 px-4">Value</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (const entry of attributeEntries) { 
                        const propKey = entry.key;
                        const propVal = entry.val;
                        
                        // Guide Mapping for Root Attributes
                        const propDesc = doc.description?.[sectionName]?.[logicalId]?.[propKey];
                        const propMeta = extractMetadata(propDesc);

                        const descText = propMeta.description;
                        const propAlias = propMeta.alias;
                        
                        const ctx = createContext([sectionName, String(logicalId), String(propKey)], false);
                    %>
                        <tr id="<%= ctx.path %>" class="hover-row scroll-mt-20">
                            <td class="property-key-cell py-3 px-4">
                                <span class="break-all">
                                    <%- renderAliasedKey(propKey, propAlias) %>
                                </span>

                                <button data-copy-path="<%= ctx.copyPath %>" class="copy-cmd-btn" title="Copy Key">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#icon-copy"></use></svg>
                                </button>
                            </td>
                            <td class="py-3 px-4 font-mono text-slate-700 align-top">
                                <div class="flex items-start gap-2">
                                    <div class="value-cell-wrapper">
                                        <%- renderValue(propVal, propDesc, ctx.child(undefined, undefined, true)) %>
                                    </div>
                                    <%- renderTooltip(descText) %>
                                </div>
                                <% if (descText) { %>
                                    <div class="elem-inline-desc-wrapper">
                                        <div class="overflow-hidden">
                                            <div class="elem-inline-desc text-slate-600 italic text-xs mt-2 border-t border-slate-200 pt-2"><%- renderMarkdownClient(descText) %></div>
                                        </div>
                                    </div>
                                <% } %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>

<!-- Table 2: Properties (Main) -->
<% if (pEntries.length > 0) { %>
    <% if (attributeEntries.length > 0) { %>
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 mt-6">Properties</h4>
    <% } %>
    <div class="table-container-standard">
        <table class="w-full text-left border-collapse table-fixed top-level-table text-sm">
            <colgroup>
                <col style="width: var(--col-width-level-0);">
                <col>
            </colgroup>
            <thead>
                <tr class="text-xs uppercase tracking-wider text-slate-600 bg-slate-200">
                    <th class="py-3 px-4 relative">
                        Property
                        <div class="col-resizer" data-level="0"></div>
                    </th>
                    <th class="py-3 px-4">Value</th>
                </tr>
            </thead>
            <tbody>
                <% for (const entry of pEntries) { 
                    const propKey = entry.key;
                    const propVal = entry.val;
                    
                    // ガイド定義の取得処理をStrategyへ委譲
                    let propDesc = undefined;
                    if (typeof strategy !== 'undefined' && strategy && strategy.getResourcePropertyGuide) {
                        propDesc = strategy.getResourcePropertyGuide(doc, sectionName, logicalId, propKey, resource);
                    } else if (isPropertiesBlock) {
                        propDesc = doc.description?.[sectionName]?.[logicalId]?.Properties?.[propKey];
                    } else {
                        propDesc = doc.description?.[sectionName]?.[logicalId]?.[propKey];
                    }
                    
                    const propMeta = extractMetadata(propDesc);

                    const descText = propMeta.description;
                    const propAlias = propMeta.alias;
                    
                    const ctx = createContext([sectionName, String(logicalId), String(propKey)], isPropertiesBlock);
                %>
                    <tr id="<%= ctx.path %>" class="hover-row scroll-mt-20">
                        <td class="property-key-cell py-3 px-4">
                            <span class="break-all">
                                <%- renderAliasedKey(propKey, propAlias) %>
                            </span>

                            <button data-copy-path="<%= ctx.copyPath %>" class="copy-cmd-btn" title="Copy Key">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#icon-copy"></use></svg>
                            </button>
                        </td>
                        <td class="py-3 px-4 font-mono text-slate-700 align-top">
                            <div class="flex items-start gap-2">
                                <div class="value-cell-wrapper">
                                    <%- renderValue(propVal, propDesc, ctx.child(undefined, undefined, true)) %>
                                </div>
                                <%- renderTooltip(descText) %>
                            </div>
                            <% if (descText) { %>
                                <div class="elem-inline-desc-wrapper">
                                    <div class="overflow-hidden">
                                        <div class="elem-inline-desc text-slate-600 italic text-xs mt-2 border-t border-slate-200 pt-2"><%- renderMarkdownClient(descText) %></div>
                                    </div>
                                </div>
                            <% } %>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>
<% } %>

<% } else { %>
    <%
        // ルートガイド定義の取得処理をStrategyへ委譲
        const rootDesc = (typeof strategy !== 'undefined' && strategy && strategy.getResourceRootGuide)
            ? strategy.getResourceRootGuide(doc, sectionName, logicalId, resource)
            : (isPropertiesBlock
                ? doc.description?.[sectionName]?.[logicalId]?.Properties
                : doc.description?.[sectionName]?.[logicalId]);
    %>
    <div class="bg-white p-4 rounded-lg border border-slate-200">
        <div class="font-mono text-slate-700">
            <%- renderValue(targetObject, rootDesc, createContext([sectionName, String(logicalId)])) %>
        </div>
    </div>
<% } %>
