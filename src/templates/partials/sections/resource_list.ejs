<div id="section-<%= sectionIndex %>-content" class="collapsible-wrapper transition-all duration-300 ease-in-out">
<div class="p-6 space-y-6 overflow-hidden min-h-0">
    <% entries.forEach(([logicalId, resource], cardIndex) => { %>
        <% 
            const guideDesc = doc.description?.[sectionName]?.[logicalId];
            const meta = extractMetadata(guideDesc);
            
            if (meta.hidden) return;

            const targetObject = resource?.Properties ? resource.Properties : resource;
            
            const alias = meta.alias;
            // Build path context
            const ctx = createContext([sectionName, String(logicalId)]);
            const uniqueId = ctx.path;

            const components = strategy.getResourceComponents(resource, sectionName);
        %>
        
        <%
            // Prepare inputs for the card component
            const cardId = uniqueId; // Outside container ID
            const contentId = `card-${sectionIndex}-${cardIndex}-content`;
            const iconId = `${contentId}-icon`;
            
            // Build title with optional alias
            const titleHtml = alias 
                ? `<span class="font-bold text-slate-800">${alias}</span> <span class="text-base text-slate-500 font-normal"></span>` 
                : logicalId;
            
            // Extra header HTML (Type Label)
            const extraHeaderHtml = components.typeLabel 
                ? `<span id="${uniqueId}_Type" class="text-xs font-mono bg-blue-100 text-blue-700 px-2 py-1 rounded ml-2">${components.typeLabel}</span>` 
                : '';
        %>

        <%- include('/partials/components/card.ejs', {
            cardId: cardId,
            contentId: contentId,
            iconId: iconId,
            title: titleHtml,
            extraHeaderHtml: extraHeaderHtml,
            isCollapsed: false,
            contentPartial: '/partials/sections/resource_content.ejs',
            contentData: {
                doc: doc,
                sectionName: sectionName,
                logicalId: logicalId,
                resource: resource,
                components: components,
                targetObject: targetObject,
                uniqueId: uniqueId,
                isIntrinsic: isIntrinsic,
                extractMetadata: extractMetadata,
                renderFlow: renderFlow,
                renderValue: renderValue,
                renderMarkdownClient: renderMarkdownClient,
                renderTooltip: renderTooltip,
                createContext: createContext
            }
        }) %>
    <% }); %>
</div>
</div>
