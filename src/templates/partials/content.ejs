<!-- Main Content -->
<main class="flex-1 min-w-0 p-8">
    <div class="w-full max-w-none px-4">

        <% renderableSections.forEach((sectionName, sectionIndex) => { %>
            <%
                const sectionGuide = doc.description?.[sectionName];
                const sectionMeta = extractMetadata(sectionGuide);
                const sectionDisplayName = sectionMeta.alias || sectionName;
            %>
            <h2 class="text-2xl font-bold text-slate-800 border-b border-slate-200 pb-2 cursor-pointer hover:text-blue-600 transition-colors flex items-center gap-2" onclick="YdockUI.Navigation.toggleSection('section-<%= sectionIndex %>-content', 'section-<%= sectionIndex %>-content-icon')">
                <span id="section-<%= sectionIndex %>-content-icon" class="text-slate-400 flex-shrink-0 rotate-icon"><svg class="w-4 h-4 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></span>
                <%= sectionDisplayName %>
            </h2>
            
            <% 
               const sectionData = doc.template[sectionName];
               const entries = (typeof sectionData === 'object' && sectionData !== null) ? Object.entries(sectionData) : [];
            %>
            
            <% if ((sectionName === 'Description') || (entries.length === 0 && (typeof sectionData !== 'object' || sectionData === null))) { %>
                <%- include('sections/text', { 
                    sectionName, 
                    sectionIndex, 
                    sectionData, 
                    renderMarkdownClient,
                    escapeHtml 
                }) %>
            <% } else if (strategy.getSectionRenderType(sectionName) === 'transform') { %>
                <%- include('sections/transform', { 
                    sectionName, 
                    sectionIndex, 
                    sectionData, 
                    doc, 
                    extractMetadata, 
                    renderTooltip, 
                    renderMarkdownClient,
                    escapeHtml 
                }) %>
            <% } else { %>
                <%- include('sections/resource_list', { 
                    entries, 
                    sectionName, 
                    sectionIndex, 
                    doc, 
                    strategy, 
                    extractMetadata, 
                    renderTooltip, 
                    renderMarkdownClient, 
                    renderFlow, 
                    isIntrinsic, 
                    renderValue,
                    escapeHtml 
                }) %>
            <% } %>
        <% }); %>
    </div>
</main>
