<!DOCTYPE html>
<html lang="<%= language %>">

<%- include('partials/head') %>
<body class="bg-slate-50 min-h-screen flex text-slate-800">
    <script>
        window.DocDockConstants = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(constants)) %>'));
        (function() {
            try {
                const C = window.DocDockConstants;
                const savedMode = localStorage.getItem(C.LocalStorageKeys.DocMode) || C.Modes.Inline;
                document.body.classList.add('mode-' + savedMode);
                const savedAliasMode = localStorage.getItem(C.LocalStorageKeys.AliasMode) || C.Modes.Show;
                if (savedAliasMode === C.Modes.Hide) document.body.classList.add(C.CssClasses.HideDeepAliases);
                const savedCompactMode = localStorage.getItem(C.LocalStorageKeys.CompactMode) || 'false';
                if (savedCompactMode === 'true') document.body.classList.add(C.CssClasses.CompactMode);
            } catch (e) {}
        })();
    </script>
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
        <symbol id="icon-copy" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </symbol>
        <symbol id="icon-info" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"></path>
        </symbol>
        <symbol id="icon-chevron-down" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </symbol>
        <symbol id="icon-chevron-left" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </symbol>
        <symbol id="icon-chevron-right" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </symbol>
    </svg>

    <!-- Sidebar -->
    <%- include('partials/sidebar', { title, doc, renderableSections, extractMetadata, constants, processedDocuments, createContext }) %>

    <!-- Main Content -->
    <%- include('partials/content', { 
        doc, 
        renderableSections, 
        processedDocuments,
        strategy, 
        extractMetadata, 
        renderTooltip, 
        renderMarkdownClient, 
        renderValue, 
        renderFlow,
        renderAliasedKey,
        isIntrinsic,
        escapeHtml,
        createContext
    }) %>
    <%- include('partials/footer') %>
</body>
</html>
