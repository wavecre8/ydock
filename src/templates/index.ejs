<!DOCTYPE html>
<html lang="<%= language || 'ja' %>" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Documentation Index' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --color-primary: #2563eb;
            --color-text-header: #0f172a;
            --color-text-main: #334155;
            --color-bg-sub: #f1f5f9;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800 antialiased">
    <div class="max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <header class="mb-10 text-center">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-3">
                <%= title || 'Documentation Index' %>
            </h1>
        </header>

        <!-- 検索およびフィルター操作領域 -->
        <div class="mb-8 max-w-xl mx-auto">
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input
                    type="text"
                    id="search-input"
                    class="block w-full pl-10 pr-10 py-2.5 bg-white border border-slate-200 rounded-xl text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm transition-all"
                    placeholder="Filter pages..."
                />
                <button
                    type="button"
                    id="clear-search"
                    class="hidden absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
                >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <% if (hasGroups && groups && groups.length > 0) { %>
            <!-- グループナビゲーション領域 -->
            <nav class="mb-10 flex flex-wrap items-center justify-center gap-2" id="group-nav">
                <% groups.forEach((group, index) => { %>
                    <button
                        type="button"
                        data-target="group-<%= index %>"
                        class="<%= constants.CssClasses.GroupNavBtn %> inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-600 hover:text-blue-600 hover:border-blue-300 hover:shadow-sm transition-all cursor-pointer"
                    >
                        <span><%= group.name %></span>
                        <span class="ml-1.5 px-1.5 py-0.5 bg-slate-100 text-slate-500 rounded-full font-mono text-[11px]">
                            <%= group.pages.length %>
                        </span>
                    </button>
                <% }); %>
            </nav>

            <!-- グループ別セクション一覧 -->
            <div class="space-y-12" id="groups-container">
                <% groups.forEach((group, index) => { %>
                    <section id="group-<%= index %>" class="<%= constants.CssClasses.GroupSection %> scroll-mt-6" data-group-name="<%= group.name %>">
                        <div class="flex items-baseline justify-between border-b border-slate-200 pb-3 mb-6">
                            <div class="flex items-center gap-3">
                                <h2 class="text-xl sm:text-2xl font-bold text-slate-800 tracking-tight">
                                    <%= group.name %>
                                </h2>
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                                    <%= group.pages.length %> <%= group.pages.length === 1 ? 'page' : 'pages' %>
                                </span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                            <% group.pages.forEach(page => { %>
                                <a
                                    href="<%= page.link %>"
                                    class="<%= constants.CssClasses.PageCard %> group block p-5 bg-white rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:border-blue-400 transition-all duration-200 flex flex-col justify-between"
                                >
                                    <div>
                                        <div class="h-6 flex items-center justify-between mb-3">
                                            <% if (page.mode && page.mode !== 'generic') { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                                    <%= page.mode === 'cfn' ? 'CloudFormation' : page.mode.toUpperCase() %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <h3
                                            class="text-base font-bold text-slate-800 group-hover:text-blue-600 transition-colors mb-2 break-words line-clamp-2"
                                            title="<%= page.title || page.filename %>"
                                        >
                                            <%= page.title || page.filename %>
                                        </h3>
                                    </div>
                                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-blue-600 font-semibold opacity-80 group-hover:opacity-100 transition-opacity">
                                        <span>View Documentation</span>
                                        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                    </div>
                                </a>
                            <% }); %>
                        </div>
                    </section>
                <% }); %>
            </div>
        <% } else { %>
            <!-- フラット形式の一覧表示 -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4" id="groups-container">
                <% pages.forEach(page => { %>
                    <a
                        href="<%= page.link %>"
                        class="<%= constants.CssClasses.PageCard %> group block p-5 bg-white rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:border-blue-400 transition-all duration-200 flex flex-col justify-between"
                    >
                        <div>
                            <div class="h-6 flex items-center justify-between mb-3">
                                <% if (page.mode && page.mode !== 'generic') { %>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                        <%= page.mode === 'cfn' ? 'CloudFormation' : page.mode.toUpperCase() %>
                                    </span>
                                <% } %>
                            </div>
                            <h3
                                class="text-base font-bold text-slate-800 group-hover:text-blue-600 transition-colors mb-2 break-words line-clamp-2"
                                title="<%= page.title || page.filename %>"
                            >
                                <%= page.title || page.filename %>
                            </h3>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-blue-600 font-semibold opacity-80 group-hover:opacity-100 transition-opacity">
                            <span>View Documentation</span>
                            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </a>
                <% }); %>
            </div>
        <% } %>

        <!-- 検索結果ゼロ時の表示 -->
        <div id="no-results" class="hidden text-center py-16">
            <p class="text-slate-400 text-sm">
                No matching documents found.
            </p>
        </div>

        <footer class="mt-16 text-center text-slate-400 text-xs">
            <p>Generated by ydock</p>
        </footer>
    </div>

    <!-- 検索およびフィルター制御スクリプト -->
    <script>
        const searchInput = document.getElementById('search-input');
        const clearButton = document.getElementById('clear-search');
        const noResults = document.getElementById('no-results');
        const cards = document.querySelectorAll('.<%= constants.CssClasses.PageCard %>');
        const sections = document.querySelectorAll('.<%= constants.CssClasses.GroupSection %>');
        const navButtons = document.querySelectorAll('.<%= constants.CssClasses.GroupNavBtn %>');
        const groupNav = document.getElementById('group-nav');

        function filterPages(keyword) {
            const query = keyword.toLowerCase().trim();
            let visibleCardCount = 0;

            if (clearButton) {
                if (query.length > 0) {
                    clearButton.classList.remove('hidden');
                } else {
                    clearButton.classList.add('hidden');
                }
            }

            cards.forEach(card => {
                const titleHeading = card.querySelector('h3');
                const title = (titleHeading && titleHeading.textContent ? titleHeading.textContent : '').toLowerCase();
                const matched = query === '' || title.includes(query);

                if (matched) {
                    card.classList.remove('hidden');
                    visibleCardCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            // 各セクションおよび対応ナビゲーションボタンの表示切替
            sections.forEach(section => {
                const sectionCards = section.querySelectorAll('.<%= constants.CssClasses.PageCard %>');
                const hasVisible = Array.from(sectionCards).some(c => !c.classList.contains('hidden'));
                const sectionId = section.getAttribute('id');
                const relatedNavButton = document.querySelector(`.<%= constants.CssClasses.GroupNavBtn %>[data-target="${sectionId}"]`);

                if (hasVisible) {
                    section.classList.remove('hidden');
                    if (relatedNavButton) {
                        relatedNavButton.classList.remove('hidden');
                    }
                } else {
                    section.classList.add('hidden');
                    if (relatedNavButton) {
                        relatedNavButton.classList.add('hidden');
                    }
                }
            });

            if (noResults) {
                if (visibleCardCount === 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }
            }

            // 検索結果ゼロ時におけるグループナビゲーション領域の表示切替
            if (groupNav) {
                if (visibleCardCount === 0) {
                    groupNav.classList.add('hidden');
                } else {
                    groupNav.classList.remove('hidden');
                }
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', e => filterPages(e.target.value));
        }

        if (clearButton && searchInput) {
            clearButton.addEventListener('click', () => {
                searchInput.value = '';
                filterPages('');
                searchInput.focus();
            });
        }

        // ナビゲーションボタン押下時のスクロール制御
        navButtons.forEach(button => {
            button.addEventListener('click', () => {
                const targetId = button.getAttribute('data-target');
                if (!targetId) return;
                const targetSection = document.getElementById(targetId);
                if (targetSection) {
                    // 対象セクション位置への移動
                    targetSection.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
</body>
</html>
