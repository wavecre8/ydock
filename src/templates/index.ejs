<!DOCTYPE html>
<html lang="<%= language || 'ja' %>" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Documentation Index' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --color-primary: #2563eb;
            --color-text-header: #0f172a;
            --color-text-main: #334155;
            --color-bg-sub: #f1f5f9;
        }

        /* カードのホバーおよびフォーカス共通ハイライトスタイル */
        .page-card,
        .page-card:focus,
        .page-card:focus-visible,
        .page-card:active {
            outline: none !important;
            outline-style: none !important;
            outline-width: 0 !important;
            outline-color: transparent !important;
            -webkit-tap-highlight-color: transparent;
        }
        .page-card {
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        body:not(:has(.page-card:focus-visible)) .page-card:hover,
        .page-card:focus-visible {
            border-color: #60a5fa !important;
            box-shadow: 0 12px 20px -3px rgb(0 0 0 / 0.12), 0 4px 6px -4px rgb(0 0 0 / 0.08) !important;
            transform: translateY(-5px);
        }
        body:not(:has(.page-card:focus-visible)) .page-card:hover h3,
        .page-card:focus-visible h3 {
            color: #2563eb;
        }
        body:not(:has(.page-card:focus-visible)) .page-card:hover .card-action,
        .page-card:focus-visible .card-action {
            opacity: 1;
            transform: translateY(0);
        }
        body:not(:has(.page-card:focus-visible)) .page-card:hover .card-action svg,
        .page-card:focus-visible .card-action svg {
            transform: translateX(2px);
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800 antialiased">
    <div class="max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <%_ const renderCard = (page) => { _%>
            <a
                href="<%= page.link %>"
                class="<%= constants.CssClasses.PageCard %> group relative flex flex-col justify-center px-5 py-4 bg-white rounded-xl shadow-sm border border-slate-200/90 outline-none focus:outline-none focus-visible:outline-none min-h-[124px]"
            >
                <% if (page.mode && page.mode !== 'generic') { %>
                    <div class="absolute top-3 left-5">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 leading-none">
                            <%= page.mode === 'cfn' ? 'CloudFormation' : page.mode.toUpperCase() %>
                        </span>
                    </div>
                <% } %>
                <h3
                    class="text-base font-bold text-slate-800 transition-colors break-words line-clamp-2 leading-snug whitespace-pre-line"
                    title="<%= page.title || page.filename %>"
                ><%= (page.title || page.filename).trim() %></h3>
                <div class="absolute bottom-2.5 right-4 pointer-events-none">
                    <span class="card-action inline-flex items-center gap-1 text-xs font-semibold text-blue-600 opacity-0 transform translate-y-1 transition-all duration-200">
                        <span>View Documentation</span>
                        <svg class="w-3.5 h-3.5 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </span>
                </div>
            </a>
        <%_ }; _%>

        <header class="mb-10 text-center">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-3">
                <%= title || 'Documentation Index' %>
            </h1>
        </header>

        <!-- 検索およびフィルター操作領域 -->
        <div class="mb-4 max-w-xl mx-auto">
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input
                    type="text"
                    id="search-input"
                    class="block w-full pl-10 pr-10 py-2.5 bg-white border border-slate-200 rounded-xl text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm transition-all"
                    placeholder="Filter pages..."
                />
                <button
                    type="button"
                    id="clear-search"
                    tabindex="-1"
                    class="hidden absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
                >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div id="search-count" class="hidden mt-2 text-center text-xs text-slate-500 font-medium">
                Found <span id="search-matched-count" class="font-semibold text-blue-600">0</span> of <span id="search-total-count">0</span> pages
            </div>
        </div>

        <% if (hasGroups && groups && groups.length > 0) { %>
            <!-- グループナビゲーション領域 -->
            <nav class="sticky top-0 z-30 py-2.5 mb-8 bg-slate-50/85 backdrop-blur-[2px] flex flex-wrap items-center justify-center gap-2" id="group-nav">
                <% groups.forEach((group, index) => { %>
                    <button
                        type="button"
                        data-target="group-<%= index %>"
                        tabindex="-1"
                        class="<%= constants.CssClasses.GroupNavBtn %> inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-600 hover:text-blue-600 hover:border-blue-300 hover:shadow-sm transition-all cursor-pointer"
                    >
                        <span><%= group.name %></span>
                        <span class="nav-count ml-1.5 px-1.5 py-0.5 bg-slate-100 text-slate-500 rounded-full font-mono text-[11px]">
                            <%= group.pages.length %>
                        </span>
                    </button>
                <% }); %>
            </nav>

            <!-- グループ別セクション一覧 -->
            <div class="space-y-12" id="groups-container">
                <% groups.forEach((group, index) => { %>
                    <section id="group-<%= index %>" class="<%= constants.CssClasses.GroupSection %> scroll-mt-20" data-group-name="<%= group.name %>">
                        <div class="flex items-baseline justify-between border-b border-slate-200 pb-3 mb-6">
                            <div class="flex items-center gap-3">
                                <h2 class="text-xl sm:text-2xl font-bold text-slate-800 tracking-tight">
                                    <%= group.name %>
                                </h2>
                                <span class="section-count px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                                    <%= group.pages.length %> <%= group.pages.length === 1 ? 'page' : 'pages' %>
                                </span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                            <% group.pages.forEach(renderCard); %>
                        </div>
                    </section>
                <% }); %>
            </div>
        <% } else { %>
            <!-- フラット形式の一覧表示 -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4" id="groups-container">
                <% pages.forEach(renderCard); %>
            </div>
        <% } %>

        <!-- 検索結果ゼロ時の表示 -->
        <div id="no-results" class="hidden text-center py-16">
            <p class="text-slate-400 text-sm">
                No matching documents found.
            </p>
        </div>

        <footer class="mt-16 text-center text-slate-400 text-xs">
            <p>Generated by ydock</p>
        </footer>
    </div>

    <!-- 検索およびフィルター制御スクリプト -->
    <script>
        (() => {
            const searchInput = document.getElementById('search-input');
            const clearButton = document.getElementById('clear-search');
            const searchCount = document.getElementById('search-count');
            const searchMatchedCount = document.getElementById('search-matched-count');
            const searchTotalCount = document.getElementById('search-total-count');
            const noResults = document.getElementById('no-results');
            const cards = document.querySelectorAll('.<%= constants.CssClasses.PageCard %>');
            const sections = document.querySelectorAll('.<%= constants.CssClasses.GroupSection %>');
            const navButtons = document.querySelectorAll('.<%= constants.CssClasses.GroupNavBtn %>');
            const groupNav = document.getElementById('group-nav');

            // 総ページ数の初期表示設定
            if (searchTotalCount) {
                searchTotalCount.textContent = String(cards.length);
            }

            // 表示状態カード一覧の抽出
            const getVisibleCards = () => {
                return Array.from(cards).filter(card => !card.classList.contains('hidden'));
            };

            // 入力要素フォーカス判定
            const isEditingText = () => {
                const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
                return activeTag === 'input' || activeTag === 'textarea';
            };

            // 各セクションおよび対応ナビゲーションボタンの表示切替と件数更新
            const updateGroupSections = () => {
                sections.forEach(section => {
                    const sectionCards = section.querySelectorAll('.<%= constants.CssClasses.PageCard %>');
                    const visibleCount = Array.from(sectionCards).filter(c => !c.classList.contains('hidden')).length;
                    const sectionId = section.getAttribute('id');
                    const relatedNavButton = document.querySelector(`.<%= constants.CssClasses.GroupNavBtn %>[data-target="${sectionId}"]`);

                    if (visibleCount > 0) {
                        section.classList.remove('hidden');
                        if (relatedNavButton) {
                            relatedNavButton.classList.remove('hidden');
                            // ナビゲーションボタン内の件数バッジ更新
                            const navCount = relatedNavButton.querySelector('.nav-count');
                            if (navCount) {
                                navCount.textContent = String(visibleCount);
                            }
                        }
                        // セクションヘッダー内の件数バッジ更新
                        const sectionCount = section.querySelector('.section-count');
                        if (sectionCount) {
                            sectionCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'page' : 'pages'}`;
                        }
                    } else {
                        section.classList.add('hidden');
                        if (relatedNavButton) {
                            relatedNavButton.classList.add('hidden');
                        }
                    }
                });
            };

            // ページ絞り込み制御
            const filterPages = keyword => {
                const query = keyword.toLowerCase().trim();
                let visibleCardCount = 0;

                // 検索入力欄クリアボタンの表示切替
                if (clearButton) {
                    if (query.length > 0) {
                        clearButton.classList.remove('hidden');
                    } else {
                        clearButton.classList.add('hidden');
                    }
                }

                cards.forEach(card => {
                    const titleHeading = card.querySelector('h3');
                    const title = (titleHeading && titleHeading.textContent ? titleHeading.textContent : '').toLowerCase();
                    const matched = query === '' || title.includes(query);

                    if (matched) {
                        card.classList.remove('hidden');
                        visibleCardCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                // 検索ヒット件数カウンターの表示更新
                if (searchCount && searchMatchedCount) {
                    if (query.length > 0) {
                        searchMatchedCount.textContent = String(visibleCardCount);
                        searchCount.classList.remove('hidden');
                    } else {
                        searchCount.classList.add('hidden');
                    }
                }

                // グループセクションおよびバッジ表示の更新
                updateGroupSections();

                if (noResults) {
                    if (visibleCardCount === 0) {
                        noResults.classList.remove('hidden');
                    } else {
                        noResults.classList.add('hidden');
                    }
                }

                // 検索結果ゼロ時におけるグループナビゲーション領域の表示切替
                if (groupNav) {
                    if (visibleCardCount === 0) {
                        groupNav.classList.add('hidden');
                    } else {
                        groupNav.classList.remove('hidden');
                    }
                }
            };

            // 検索入力イベントの登録
            if (searchInput) {
                searchInput.addEventListener('input', e => filterPages(e.target.value));
            }

            // クリアボタンクリックイベントの登録
            if (clearButton && searchInput) {
                clearButton.addEventListener('click', () => {
                    searchInput.value = '';
                    // 検索入力欄初期化後の再抽出
                    filterPages('');
                    // 検索入力欄へのフォーカス復帰
                    searchInput.focus();
                });
            }

            // ナビゲーションボタン押下時のスクロール制御
            navButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const targetId = button.getAttribute('data-target');
                    if (!targetId) return;
                    const targetSection = document.getElementById(targetId);
                    if (targetSection) {
                        // 対象セクション位置への移動
                        targetSection.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });

            // マウス操作時のフォーカス解除によるハイライト排他制御
            cards.forEach(card => {
                const clearOtherCardFocus = () => {
                    if (document.activeElement && document.activeElement.classList.contains('<%= constants.CssClasses.PageCard %>') && document.activeElement !== card) {
                        // 直前のアクティブカードからのフォーカス解除
                        document.activeElement.blur();
                    }
                };
                card.addEventListener('mouseenter', clearOtherCardFocus);
                card.addEventListener('mousemove', clearOtherCardFocus);
            });

            // キーボードショートカット操作の監視
            document.addEventListener('keydown', e => {
                if (e.key === '/' && document.activeElement !== searchInput) {
                    if (!isEditingText()) {
                        // デフォルト文字入力動作の抑止
                        e.preventDefault();
                        if (searchInput) {
                            // 検索入力欄へのフォーカス設定
                            searchInput.focus();
                        }
                    }
                } else if (e.key === 'Escape' && document.activeElement === searchInput) {
                    if (searchInput) {
                        // 検索入力欄からのフォーカス解除
                        searchInput.blur();
                    }
                } else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                    if (!isEditingText()) {
                        // 表示中カード一覧の抽出
                        const visibleCards = getVisibleCards();
                        if (visibleCards.length === 0) return;

                        // 現在フォーカス位置の特定
                        const currentIndex = visibleCards.indexOf(document.activeElement);
                        let targetIndex = -1;

                        if (e.key === 'ArrowRight') {
                            if (currentIndex === -1) {
                                targetIndex = 0;
                            } else if (currentIndex < visibleCards.length - 1) {
                                targetIndex = currentIndex + 1;
                            }
                        } else if (e.key === 'ArrowLeft') {
                            if (currentIndex > 0) {
                                targetIndex = currentIndex - 1;
                            }
                        }

                        if (targetIndex !== -1) {
                            // ブラウザ既定スクロール動作の抑止
                            e.preventDefault();
                            // 対象カードへのフォーカス遷移
                            visibleCards[targetIndex].focus();
                        }
                    }
                }
            });
        })();
    </script>
</body>
</html>
