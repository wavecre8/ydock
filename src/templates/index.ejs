<!DOCTYPE html>
<html lang="<%= language || 'ja' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documentation Index</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
    <style>
        /* Reusing variables from style.css for consistency */
        :root {
            --color-primary: #2563eb;
            --color-text-header: #0f172a;
            --color-text-main: #334155;
            --color-bg-sub: #f1f5f9;
        }
    </style>

    <div class="max-w-7xl mx-auto px-6 py-12">
        <header class="mb-12 text-center">
            <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl mb-4">
                <%= title || 'Documentation Index' %>
            </h1>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% pages.forEach(page => { %>
                <a href="<%= page.link %>" class="group block p-6 bg-white rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 flex flex-col">
                    <div class="h-8 flex items-center justify-between mb-4">
                        <% if (page.mode !== 'generic') { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                            <%= page.mode === 'cfn' ? 'CloudFormation' : page.mode.toUpperCase() %>
                        </span>
                        <% } %>
                    </div>
                    <h2 class="text-xl font-bold text-slate-800 group-hover:text-blue-600 transition-colors mb-2 flex-grow">
                        <%= page.title %>
                    </h2>
                    <div class="mt-4 flex items-center text-sm text-blue-600 font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                        View Documentation
                        <svg class="ml-1 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </div>
                </a>
            <% }); %>
        </div>

        <footer class="mt-16 text-center text-slate-400 text-sm">
            <p>Generated by ydock</p>
        </footer>
    </div>
</body>
</html>
