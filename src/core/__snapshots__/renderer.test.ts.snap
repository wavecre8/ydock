// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`TemplateRenderer > renderFlow (array) > should render array items 1`] = `
"<span class="font-mono text-slate-600 inline-flex flex-wrap items-center gap-y-1">
            <span class="text-slate-400 mr-1">[</span><span class="property-value font-mono text-slate-700">1</span><span class="text-slate-400 mx-1">,</span><span class="property-value font-mono text-slate-700">2</span><span class="text-slate-400 ml-1">]</span>
        </span>"
`;

exports[`TemplateRenderer > renderFlow (primitive) > should render number 1`] = `"<span class="property-value font-mono text-slate-700">123</span>"`;

exports[`TemplateRenderer > renderFlow (primitive) > should render string 1`] = `"<span class="property-value font-mono text-slate-700">hello</span>"`;

exports[`TemplateRenderer > renderIntrinsic > should render intrinsic function 1`] = `"<div class="flex items-start gap-2"><span class="badge-fn">!Ref</span> <span><span class="property-value">MyResource</span></span></div>"`;

exports[`TemplateRenderer > renderValue (Table) > should render object as table 1`] = `
"<table class="table-base nested-table text-sm bg-white">
            <colgroup>
                <col style="width: var(--col-width-level-0, var(--col-width-level-default));">
                <col>
            </colgroup>
            <thead>
                <tr>
                    <th class="relative">
                        Property
                        <div class="col-resizer" data-level="0"></div>
                    </th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                <tr id="root.key1" class="hover-row scroll-mt-20">
            <td class="property-key-cell">
                <span class="break-all">key1</span>
                <button data-copy-path="key1" class="copy-cmd-btn" title="Copy Key">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#icon-copy"></use></svg>
                </button>
            </td>
            <td class="align-top">
                <div class="flex items-start h-full">
                    <div class="flex-grow w-full min-w-0"><span class="property-value">value1</span></div>
                    
                </div>
                
            </td>
        </tr>
            </tbody>
        </table>"
`;
